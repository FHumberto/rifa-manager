@page "/login"

<PageTitle>Entrar</PageTitle>

<PageTitleText Title="Entrar" Subtitle="Acesse sua conta para gerenciar as rifas." />

<MudPaper Class="pa-4" Elevation="0" Outlined="true" MaxWidth="420px">
    <MudTextField T="string" Label="E-mail" InputType="InputType.Email" Variant="Variant.Outlined" />
    <MudTextField T="string" Label="Senha" InputType="InputType.Password" Variant="Variant.Outlined" Class="mt-3" />
    <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-4">Entrar</MudButton>
</MudPaper>
